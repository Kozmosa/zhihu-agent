# 复制为 .env 后，源码运行会在启动时自动读取；已在进程中设置的变量优先于此文件。
# 打包桌面版不读取 .env。本文件仅作参考，已被 .gitignore 排除，不要提交真实密钥。
# 相对路径按项目根目录解析。
ZHIJING_DATA_DIR=data
ZHIJING_MODEL_PROVIDER=extractive
# 可选：ollama；五项能力均使用同一服务。先准备API与模型，不会自动下载。
# URL填服务器根地址或/api基地址，不要填/api/generate或/v1/chat/completions。
ZHIJING_OLLAMA_URL=http://127.0.0.1:11434
ZHIJING_OLLAMA_MODEL=qwen3:8b
# 本地通常留空；需要鉴权的远程服务通过进程环境变量设置，不要提交真实密钥。
ZHIJING_OLLAMA_API_KEY=
ZHIJING_OLLAMA_TIMEOUT=120
# schema: 使用原生JSON Schema；json: JSON模式；prompt: 不传format但仍校验JSON。
ZHIJING_OLLAMA_FORMAT=schema
ZHIJING_OLLAMA_MAX_INPUT_CHARS=120000
ZHIJING_OLLAMA_NUM_PREDICT=4096
ZHIJING_OLLAMA_NUM_CTX=32768

# OpenAI-compatible Chat Completions (or use the local settings page)
# ZHIJING_MODEL_PROVIDER=openai
ZHIJING_OPENAI_URL=https://api.openai-next.com/v1
ZHIJING_OPENAI_MODEL=deepseek-v4-flash
ZHIJING_OPENAI_API_KEY=
ZHIJING_OPENAI_FORMAT=json
ZHIJING_OPENAI_TIMEOUT=120
ZHIJING_OPENAI_MAX_INPUT_CHARS=120000
ZHIJING_OPENAI_MAX_TOKENS=4096
ZHIJING_OPENAI_CONTEXT_WINDOW=32768

# 官方知乎搜索；也可在知识工作台中配置，仅保留当前服务会话。
# 从 developer.zhihu.com 个人中心获取；不要提交真实凭证。
ZHIHU_ACCESS_SECRET=
ZHIHU_SEARCH_TIMEOUT=20

# 监听与公网部署（Render 等长驻平台）。默认仅监听本机 127.0.0.1:8000。
# ZHIJING_HOST=0.0.0.0
# ZHIJING_PORT=8000
# 追加允许的 Host 头，逗号分隔，支持 *.example.com 通配；留空时公网域名一律 400。
# ZHIJING_ALLOWED_HOSTS=your-app.onrender.com
# 可选 API 访问令牌：设置后非本机客户端调用 /api/v1/* 须携带 Authorization: Bearer <令牌>。
# 至少 16 个可打印 ASCII 字符；本机访问、/health 和设置接口不受影响。
# ZHIJING_API_TOKEN=generate-a-long-random-secret
