# PowerShell 启动脚本读取环境变量；本文件只是配置参考，不会自动加载。
ZHIJING_DATA_DIR=E:/CzCode/codex/state/zhijing
ZHIJING_MODEL_PROVIDER=extractive
# 可选：ollama；五项能力均使用同一服务。先准备API与模型，不会自动下载。
# URL填服务器根地址或/api基地址，不要填/api/generate或/v1/chat/completions。
ZHIJING_OLLAMA_URL=http://127.0.0.1:11434
ZHIJING_OLLAMA_MODEL=qwen3:8b
# 本地通常留空；需要鉴权的远程服务通过进程环境变量设置，不要提交真实密钥。
ZHIJING_OLLAMA_API_KEY=
ZHIJING_OLLAMA_TIMEOUT=120
# schema: 使用原生JSON Schema；json: JSON模式；prompt: 不传format但仍校验JSON。
ZHIJING_OLLAMA_FORMAT=schema
ZHIJING_OLLAMA_MAX_INPUT_CHARS=120000
ZHIJING_OLLAMA_NUM_PREDICT=4096
ZHIJING_OLLAMA_NUM_CTX=32768
